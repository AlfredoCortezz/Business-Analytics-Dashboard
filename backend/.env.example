# Copia este archivo a .env y ajusta los valores segun tu entorno.
# Base de datos: SQLite para desarrollo local, PostgreSQL para despliegue.
DATABASE_URL=sqlite:///./dev.db
# Ejemplo PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ba_dashboard

MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
