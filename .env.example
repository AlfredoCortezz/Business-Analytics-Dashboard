# === Backend ===
# SQLite para desarrollo local
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL para despliegue (requiere psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ba_dashboard

# Límite de tamaño de archivo de subida (MB)
MAX_UPLOAD_MB=5

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Carpeta donde se guardan los archivos subidos (para confirmar importaciones)
UPLOAD_DIR=uploads

# === Frontend ===
# Base de la API consumida por el frontend (por defecto usa el proxy de Vite)
VITE_API_BASE=/api
